                </div>
                <span className="text-xs font-bold w-10 text-right flex-shrink-0" style={{ color: "var(--teal-text)" }}>{s.rate}%</span>
              </div>
            </li>
          ))}
        </ul>
      </motion.section>
    </motion.div>
  );
}
