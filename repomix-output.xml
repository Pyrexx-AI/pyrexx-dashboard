  recentCalls: Meeting[];
  recentlyBooked: Meeting[];
  upcomingBookings: Meeting[];
  metrics: DashboardMetrics;
  loadingSummary: boolean;
  loadingMetrics: boolean;
  hasClinic: boolean;
}) {
