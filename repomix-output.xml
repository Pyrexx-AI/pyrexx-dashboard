          <div>
            <label className="block text-xs font-semibold mb-1.5" style={{ color: "var(--text-secondary)" }}>Website (optional)</label>
            <input
              value={editClinicForm.website}
              onChange={(e) => setEditClinicForm((f) => ({ ...f, website: e.target.value }))}
