# ─── AI Receptionist Agent Platform ───────────────────────────────
# Used to verify the x-retell-signature header on incoming webhooks.
# Found in: agent platform dashboard (Retell) → Settings → API Keys
RETELL_API_KEY=

# Optional: only needed if the dashboard itself calls the agent
# platform's REST API directly (e.g. to fetch call history on demand,
# or trigger outbound calls). Webhook ingestion alone does not
# require this — that flow is push-based from the platform to the
# dashboard.
# RETELL_API_BASE_URL=https://api.retellai.com

# ─── Supabase ──────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE ROLE key — bypasses RLS. Server-only, never expose to the
# browser. Used by webhook handlers and the /api/onboarding route.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Dodo Payments ─────────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# The Dodo product/price ID for the $1,000/mo Pyrexx AI Receptionist
# plan — create this once in the Dodo dashboard under Products.
DODO_PRODUCT_ID=
# Optional override; defaults to https://api.dodopayments.com
# DODO_API_BASE_URL=
