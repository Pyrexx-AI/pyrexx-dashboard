<file path="src/app/globals.css">
@import "tailwindcss";

/* ─── Design Tokens ──────────────────────────────────────────────── */
/* Light mode — soft pastel, clinical-modern, airy */
:root {
  /* Surfaces */
  --bg-base:          #F4F6FF;   /* barely-lavender canvas */
  --bg-card:          #FFFFFF;
  --bg-raised:        #FFFFFF;
  --bg-sunken:        #F0F2FA;

  /* Borders */
  --border-subtle:    rgba(100, 116, 139, 0.10);
  --border-medium:    rgba(100, 116, 139, 0.18);
  --border-strong:    rgba(100, 116, 139, 0.30);

  /* Text */
  --text-primary:     #111827;
  --text-secondary:   #4B5563;
  --text-muted:       #9CA3AF;
  --text-placeholder: #CBD5E1;

  /* Brand */
  --teal:             #48C4C6;
  --purple:           #8952A5;
  --teal-surface:     #EAF8F8;   /* pastel teal */
  --purple-surface:   #F2EAFA;   /* pastel purple */
  --teal-text:        #2B9496;
  --purple-text:      #6B3D85;

  /* Semantic */
  --success-surface:  #ECFDF5;
  --success-text:     #059669;
  --warning-surface:  #FFFBEB;
  --warning-text:     #D97706;
  --error-surface:    #FEF2F2;
  --error-text:       #DC2626;
  --info-surface:     #EFF6FF;
  --info-text:        #2563EB;

  /* Shadows */
  --shadow-xs:    0 1px 2px rgba(17,24,39,0.04);
  --shadow-sm:    0 1px 3px rgba(17,24,39,0.04), 0 4px 12px rgba(17,24,39,0.04);
  --shadow-md:    0 4px 16px rgba(17,24,39,0.06), 0 1px 4px rgba(17,24,39,0.04);
  --shadow-lg:    0 8px 32px rgba(17,24,39,0.08), 0 2px 8px rgba(17,24,39,0.04);
  --shadow-xl:    0 16px 48px rgba(17,24,39,0.10), 0 4px 16px rgba(17,24,39,0.06);
  --shadow-float: 0 20px 60px rgba(17,24,39,0.12), 0 6px 20px rgba(17,24,39,0.06);

  /* Toggle — light mode pill */
  --toggle-bg:        #DDE1F0;
  --toggle-active-bg: #FFFFFF;
  --toggle-active-fg: #F59E0B;  /* sun amber */
  --toggle-inactive-fg: #94A3B8;

  /* Loading-animation logo colors — sampled from the official mark.
     Outline = dark charcoal (matches the real logo on light surfaces).
     Gap = the white/cream cutout color between ribbons. */
  --logo-outline: #211C2E;
  --logo-gap:     #FFFFFF;

  color-scheme: light;
}

/* Dark mode */
/*
  REDESIGNED — previous dark theme (#0D0818 base / #160B24 cards) read
  as near-black and crushed contrast between surfaces. New palette is
  a lighter "midnight slate-purple": surfaces sit ~8-10% lighter, with
  more visible borders and brighter secondary text, while keeping the
  same brand-purple undertone.
*/
html.dark {
  --bg-base:          #1A1626;   /* was #0D0818 — lighter charcoal-purple canvas */
  --bg-card:          #251F38;   /* was #160B24 */
  --bg-raised:        #302849;   /* was #1E0F30 */
  --bg-sunken:        #150F20;   /* was #0A0514 */

  --border-subtle:    rgba(176, 145, 214, 0.14);
  --border-medium:    rgba(176, 145, 214, 0.24);
  --border-strong:    rgba(176, 145, 214, 0.42);

  --text-primary:     #F5F3FA;   /* brighter than #F1F5F9 for better contrast */
  --text-secondary:   #ADA3C4;   /* was #94A3B8 — warmer + lighter */
  --text-muted:       #7E7396;   /* was #64748B */
  --text-placeholder: #443B5C;

  --teal-surface:     rgba(72, 196, 198, 0.13);
  --purple-surface:   rgba(137, 82, 165, 0.16);
  --teal-text:        #6EE0E2;
  --purple-text:      #C09AE0;

  --success-surface:  rgba(5, 150, 105, 0.16);
  --success-text:     #3EE6AD;
  --warning-surface:  rgba(217, 119, 6, 0.16);
  --warning-text:     #FDD877;
  --error-surface:    rgba(220, 38, 38, 0.16);
  --error-text:       #FF8A8A;
  --info-surface:     rgba(37, 99, 235, 0.16);
  --info-text:        #7DB4FF;

  --shadow-xs:    0 1px 2px rgba(0,0,0,0.30);
  --shadow-sm:    0 1px 3px rgba(0,0,0,0.30), 0 4px 14px rgba(0,0,0,0.22);
  --shadow-md:    0 4px 18px rgba(0,0,0,0.32), 0 1px 4px rgba(0,0,0,0.24);
  --shadow-lg:    0 8px 36px rgba(0,0,0,0.38), 0 2px 10px rgba(0,0,0,0.26);
  --shadow-xl:    0 18px 52px rgba(0,0,0,0.42), 0 4px 18px rgba(0,0,0,0.30);
  --shadow-float: 0 22px 64px rgba(0,0,0,0.50), 0 6px 22px rgba(137,82,165,0.20);

  --toggle-bg:        #150F20;
  --toggle-active-bg: #302849;
  --toggle-active-fg: #A78CF0;  /* moon indigo — slightly brighter on lighter bg */
  --toggle-inactive-fg: #5E5478;

  /* Loading-animation logo colors for dark mode — outline becomes a
     soft muted lavender-gray (visible but gentle against the lighter
     dark base), gap stays a soft off-white for a subtle glow. */
  --logo-outline: #564A78;
  --logo-gap:     #F4F1FA;

  color-scheme: dark;
}

/* ─── Tailwind v4 Theme Registration ────────────────────────────── */
@theme inline {
  --color-background: var(--bg-base);
  --color-foreground: var(--text-primary);
  --color-card:       var(--bg-card);

  /* Pyrexx brand */
  --color-pyrexx-blue:    #48C4C6;
  --color-pyrexx-purple:  #8952A5;
  --color-pyrexx-darkBg:  #1A1626;
  --color-pyrexx-darkCard:#251F38;
  --color-pyrexx-surface: #302849;

  --font-sans: var(--font-inter, ui-sans-serif, system-ui, sans-serif);
}

/* ─── Base Styles ────────────────────────────────────────────────── */
body {
  background-color: var(--bg-base);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ─── Dashboard dot-grid background (light only) ─────────────────── */
.dashboard-bg {
  background-color: var(--bg-base);
  background-image: radial-gradient(
    circle,
    rgba(100, 116, 139, 0.10) 1px,
    transparent 1px
  );
  background-size: 24px 24px;
}
html.dark .dashboard-bg {
  background-image: radial-gradient(
    circle,
    rgba(137, 82, 165, 0.06) 1px,
    transparent 1px
  );
}

/* ─── Card base ──────────────────────────────────────────────────── */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  box-shadow: var(--shadow-sm);
  border-radius: 1.25rem;
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}
.card-hover:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

/* ─── Toggle pill ─────────────────────────────────────────────────── */
.theme-toggle-pill {
  display: flex;
  align-items: center;
  padding: 3px;
  border-radius: 9999px;
  background: var(--toggle-bg);
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.10), inset 0 1px 2px rgba(0,0,0,0.07);
}
html.dark .theme-toggle-pill {
  box-shadow: inset 0 2px 6px rgba(0,0,0,0.40), inset 0 1px 3px rgba(0,0,0,0.30);
}
.theme-toggle-btn {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 14px;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 0.22s cubic-bezier(0.34, 1.2, 0.64, 1);
  cursor: pointer;
  border: none;
  background: transparent;
  color: var(--toggle-inactive-fg);
}
.theme-toggle-btn.active {
  background: var(--toggle-active-bg);
  color: var(--toggle-active-fg);
  box-shadow: 0 1px 4px rgba(0,0,0,0.12), 0 0 0 0.5px rgba(0,0,0,0.06);
}

/* ─── Status badges ──────────────────────────────────────────────── */
.badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  border-radius: 9999px;
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  white-space: nowrap;
}

/* ─── Scrollbar ─────────────────────────────────────────────────── */
.custom-scroll {
  scrollbar-width: thin;
  scrollbar-color: var(--border-medium) transparent;
}
.custom-scroll::-webkit-scrollbar { width: 4px; }
.custom-scroll::-webkit-scrollbar-track { background: transparent; }
.custom-scroll::-webkit-scrollbar-thumb {
  background: var(--border-medium);
  border-radius: 9999px;
}

/* ─── Focus visible ──────────────────────────────────────────────── */
:focus-visible {
  outline: 2px solid #48C4C6;
  outline-offset: 2px;
  border-radius: 4px;
}

/* ─── Reduced motion ─────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}

/* ─── Touch optimisation ─────────────────────────────────────────── */
button, [role="button"] {
  touch-action: manipulation;
}

html { scroll-behavior: smooth; }
</file>

