            cx="50"
            cy="50"
            r="42"
            stroke="var(--teal)"
            strokeWidth="4"
            strokeLinecap="round"
            initial={{ pathLength: 0, rotate: 0 }}
            animate={{ pathLength: [0.2, 0.8, 0.2], rotate: 360 }}
            transition={{
              duration: 1.8,
              repeat: Infinity,
              ease: "easeInOut",
            }}
          />
          <motion.circle
            cx="50"
            cy="50"
            r="32"
            stroke="var(--purple)"
            strokeWidth="4"
            strokeLinecap="round"
            initial={{ pathLength: 0, rotate: 0 }}
            animate={{ pathLength: [0.6, 0.1, 0.6], rotate: -360 }}
