"use client";

import React from "react";
import { motion } from "framer-motion";

export default function LoadingAnimation() {
  return (
    <motion.div
      initial={{ opacity: 1 }}
      exit={{ opacity: 0 }}
      transition={{ duration: 0.6, ease: "easeInOut" }}
      className="fixed inset-0 z-[100] flex flex-col items-center justify-center bg-white dark:bg-[#0A0B0D]"
    >
      <div className="relative flex flex-col items-center">
        {/* Glowing Background Pulse matching the logo colors */}
        <motion.div
          animate={{ scale: [1, 1.2, 1], opacity: [0.15, 0.3, 0.15] }}
          transition={{ repeat: Infinity, duration: 3, ease: "easeInOut" }}
          className="absolute w-48 h-48 bg-gradient-to-tr from-[#48C4C6] to-[#8952A5] rounded-full blur-3xl"
        />
        
        {/* Animated Custom 'X' Logo */}
        <div className="relative w-24 h-24 z-10 flex items-center justify-center drop-shadow-2xl">
          <svg 
            viewBox="0 0 100 100" 
            className="w-full h-full overflow-visible" 
            fill="none" 
            xmlns="http://www.w3.org/2000/svg"
          >
            {/* Cyan / Teal Stroke */}
            <motion.path
              d="M20 20 L80 80"
              stroke="#48C4C6"
              strokeWidth="16"
              strokeLinecap="round"
              initial={{ pathLength: 0, opacity: 0 }}
              animate={{ pathLength: 1, opacity: 1 }}
              transition={{ 
                duration: 1.2, 
                repeat: Infinity, 
                repeatType: "reverse", 
                ease: "easeInOut" 
              }}
            />
            {/* Purple Stroke */}
            <motion.path
              d="M20 80 L80 20"
              stroke="#8952A5"
              strokeWidth="16"
              strokeLinecap="round"
              initial={{ pathLength: 0, opacity: 0 }}
              animate={{ pathLength: 1, opacity: 1 }}
              transition={{ 
                duration: 1.2, 
                delay: 0.6, // Delays the purple stroke so they "chase" each other
                repeat: Infinity, 
                repeatType: "reverse", 
                ease: "easeInOut" 
              }}
            />
          </svg>
        </div>

        {/* Loading Text */}
        <div className="mt-10 flex flex-col items-center z-10">
          <h2 className="text-3xl font-extrabold tracking-tight flex gap-1.5">
            <span className="text-gray-900 dark:text-white">Pyrexx</span>
            <span className="text-gray-500 font-light">AI</span>
          </h2>
          <div className="flex items-center mt-3 space-x-1">
            <span className="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-widest">
              Initializing Environment
            </span>
          </div>
        </div>

        {/* Smooth Gradient Progress Bar */}
        <div className="w-56 h-1 bg-gray-100 dark:bg-gray-800 rounded-full mt-8 overflow-hidden z-10">
          <motion.div 
            initial={{ width: 0 }}
            animate={{ width: "100%" }}
            transition={{ duration: 2.5, ease: "easeInOut" }}
            className="h-full bg-gradient-to-r from-[#48C4C6] to-[#8952A5] rounded-full"
          />
        </div>
      </div>
    </motion.div>
  );
}
