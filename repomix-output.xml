          {editClinicError && <p className="text-[11px]" style={{ color: "var(--error-text)" }} role="alert">{editClinicError}</p>}
          <div className="flex gap-2 justify-end mt-2 pt-3 border-t" style={{ borderColor: "var(--border-subtle)" }}>
